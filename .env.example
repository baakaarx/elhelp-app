# Copy to server/.env and fill in real values. Never commit this file.
# Required: the first administrator is created from these two values on the first start.
NODE_ENV=production
PORT=3000
ADMIN_EMAIL=manager@your-company.com
# At least 12 characters. Choose a unique value; never reuse the template.
ADMIN_PASSWORD=
# Absolute path to a persistent disk. On a VPS: /var/lib/elhelp/mandoub.db
DB_PATH=/var/lib/elhelp/mandoub.db
RETENTION_DAYS=365
# Minutes without a GPS point before the field is flagged as losing signal (3–120).
STALE_GPS_MINUTES=10
# Minutes of stillness before the engineer is asked for a reason and you are alerted (15–240).
# The phone reads this value from the server, so changing it does not need a new APK.
IDLE_REASON_MINUTES=60
TIMEZONE=Africa/Cairo
# Exact HTTPS browser origins, comma-separated. No wildcard.
ALLOWED_ORIGINS=https://tracking.your-company.com
# Which proxy may set X-Forwarded-For. `loopback` (the default in production) trusts only
# Caddy on the same machine; set `1` behind Docker or another hop, or `false` when the port is
# reachable directly. Getting this wrong makes every request look like 127.0.0.1, so a handful
# of failed logins would rate-limit the whole team.
TRUST_PROXY=loopback
# Printed on the public /privacy page. Defaults to privacy@<domain of ADMIN_EMAIL>.
PRIVACY_CONTACT=privacy@your-company.com

# ── تسجيل الدخول بـ Google / Apple (اختياري) ──────────────────────────────────
# كل الـclient ids اللي السيرفر بيقبل رموزها، مفصولة بفاصلة. iOS وAndroid وWeb لكل واحد
# client id مختلف، والرمز بيوصل بـ`aud` مختلف — فسجّل الثلاثة هنا.
# سيبها فاضية = الأزرار مش هتظهر في التطبيق خالص.
GOOGLE_CLIENT_IDS=
# للـiPhone: معرّف التطبيق (bundle id). ولو فعّلت الدخول من الويب كمان: الـServices ID.
APPLE_CLIENT_IDS=com.elhelb.mandoub

# ── المصادقة الثنائية للمدير (اختياري لكن مستحسن) ─────────────────────────────
# شغّل `npm run totp` على السيرفر: بيطبع مفتاحًا سريًا ولينك يتحط في Google Authenticator أو
# أي تطبيق مصادقة. من ساعتها دخول المدير بكلمة المرور بيطلب الرقم الستة كمان.
# سيبها فاضية = المصادقة الثنائية مقفولة (وده الافتراضي عشان مايتقفلش حد برّه).
# احتفظ بالمفتاح في مدير كلمات المرور: من غيره مفيش دخول للوحة.
ADMIN_TOTP_SECRET=
