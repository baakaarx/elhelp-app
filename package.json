{
  "name": "mandoub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "dashboard",
    "mobile"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n API,Dashboard -c green,cyan \"npm run dev -w @mandoub/server\" \"npm run dev -w @mandoub/dashboard\"",
    "dev:mobile": "npm run start -w @mandoub/mobile",
    "build": "npm run build -w @mandoub/server && npm run build -w @mandoub/dashboard && npm run export:web -w @mandoub/mobile",
    "start": "npm run start -w @mandoub/server",
    "test": "npm run test -w @mandoub/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "node scripts/reset-e2e-db.mjs && playwright test",
    "smoke": "node scripts/smoke.mjs",
    "totp": "node --experimental-strip-types scripts/totp.mjs",
    "preview": "node scripts/preview.mjs",
    "agent": "npm run agent -w @mandoub/server",
    "agent:skills": "npm run agent -w @mandoub/server -- skills",
    "build:apk": "node scripts/build-apk.mjs",
    "build:aab": "node scripts/build-apk.mjs --aab",
    "keystore": "node scripts/create-keystore.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  }
}
