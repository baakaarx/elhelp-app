# Copy to server/.env. Never commit real credentials.
NODE_ENV=production
PORT=3000
DEMO_MODE=false
ADMIN_EMAIL=admin@your-company.com
# Required in production; choose a unique password with at least 12 characters.
ADMIN_PASSWORD=
# Optional: absolute path to a persistent private disk.
# DB_PATH=/var/lib/mandoub/mandoub.db
RETENTION_DAYS=30
TIMEZONE=Africa/Cairo
# Exact HTTPS browser origins, comma-separated. No wildcard.
ALLOWED_ORIGINS=https://tracking.your-company.com
