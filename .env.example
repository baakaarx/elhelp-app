# PRODUCTION ONLY.
# Do not copy this file into server/.env on a development machine: NODE_ENV=production and
# the placeholder ADMIN_EMAIL below decide who the first administrator is, and the demo
# login (admin@mandoub.test / Demo1234!) stops working. `npm run dev` needs no .env at all.
# Never commit real credentials.
NODE_ENV=production
PORT=3000
DEMO_MODE=false
# Replace this placeholder. It is the email of the first administrator account.
ADMIN_EMAIL=admin@your-company.com
# Required in production; choose a unique password with at least 12 characters.
ADMIN_PASSWORD=
# Optional: absolute path to a persistent private disk.
# DB_PATH=/var/lib/mandoub/mandoub.db
RETENTION_DAYS=30
# Minutes without a GPS point before the field is flagged as losing signal (3–120).
# The dashboard reads this value from the API, so both sides always agree.
STALE_GPS_MINUTES=10
TIMEZONE=Africa/Cairo
# Exact HTTPS browser origins, comma-separated. No wildcard.
ALLOWED_ORIGINS=https://tracking.your-company.com
